# Dependencies
node_modules/
ui/node_modules/
docs/node_modules/

# Generated LLM documentation (rebuilt by scripts/generate-llms.ts on every
# build). The llms.txt index is committed like sitemap.xml; the per-page
# Markdown, the compact llms-small.txt and the full text are not.
apps/docs/public/llms/
apps/docs/public/llms-small.txt
apps/docs/public/llms-full.txt

# Build outputs
ui/lib/
charts/lib/
packages/*/lib/
docs/dist/
docs/.expo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Expo
.expo/
dist/
web-build/

# Android builds
*.aab
*.apk

# TypeScript
*.tsbuildinfo
*.d.ts
# ...except hand-written ambient declarations in package sources.
!packages/*/src/**/*.d.ts

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# other 
*.map

# expo
android/
ios/
*.app
*.tar.gz

# testing
test-results/
docs/assets/chart-baselines/*.png
*.snap
# Jest snapshots are part of the test suite: `jest --ci` fails on a snapshot
# that isn't committed, so they must be tracked.
!packages/ui/src/**/__snapshots__/*.snap
design-review/
# Playwright screenshot baselines are committed for visual CI (via Git LFS; see .gitattributes).