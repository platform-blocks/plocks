{
  "name": "@plocks/ui-snack",
  "version": "0.3.0",
  "description": "Curated single-file plocks UI entry for Expo Snack",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./lib/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": null,
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf lib && rollup -c && node scripts/emit-types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "sh -c 'if [ \"$BUILD_ON_PREPARE\" = \"1\" ]; then npm run build; fi'"
  },
  "peerDependencies": {
    "@plocks/ui": "^0.3.0",
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "@react-native-masked-view/masked-view": ">=0.3.0",
    "@shopify/flash-list": ">=1.6.0",
    "expo-clipboard": ">=3.0.0",
    "expo-document-picker": ">=13.0.0",
    "expo-haptics": ">=14.0.0",
    "expo-linear-gradient": ">=12.0.0",
    "expo-navigation-bar": ">=1.0.0",
    "expo-status-bar": ">=1.12.0",
    "react": ">=18.0.0 <20.0.0",
    "react-native": ">=0.79.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.5.0",
    "react-native-safe-area-context": ">=4.5.0",
    "react-native-svg": ">=13.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-native-masked-view/masked-view": {
      "optional": true
    },
    "@shopify/flash-list": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    },
    "expo-document-picker": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-linear-gradient": {
      "optional": true
    },
    "expo-navigation-bar": {
      "optional": true
    },
    "expo-status-bar": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.57.0",
    "typescript": "~6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platform-blocks/plocks.git",
    "directory": "packages/ui-snack"
  }
}
